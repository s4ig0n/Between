{
  "expo": {
    "name": "Between",
    "slug": "between",
    "scheme": "between",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.between.patient"
    },
    "android": {
      "package": "app.between.patient",
      "adaptiveIcon": {
        "backgroundColor": "#1F3A93",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-calendar",
        {
          "calendarPermission": "Between adds your exercise sessions and therapy visits to a separate Between calendar."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
