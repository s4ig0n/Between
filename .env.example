# Epic on FHIR, NON-PRODUCTION (sandbox) only. Leave the client ID empty to run on sample data.
# The client ID of a public SMART app is not a secret, but keep your own copy in .env (not committed).
EXPO_PUBLIC_EPIC_CLIENT_ID=
EXPO_PUBLIC_EPIC_FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
